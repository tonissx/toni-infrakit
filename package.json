{
  "name": "toni-infrakit",
  "productName": "Toni Infrakit",
  "version": "0.1.0",
  "description": "Toni Infrakit — ferramentas para a equipe de infraestrutura: encontrar, instalar e testar impressoras (rede, USB, WSD).",
  "author": "Antonio Gonçalves",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build": "node scripts/build-renderer.mjs",
    "watch": "node scripts/build-renderer.mjs --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "demo": "npm run build && electron . --demo",
    "icon": "electron scripts/render-icon.cjs",
    "test": "node --test scripts/test-printers-model.mjs scripts/test-printers-inf.mjs scripts/test-printers-ipp.mjs scripts/test-printers-snmp.mjs scripts/test-printers-mdns.mjs scripts/test-printers-ranges.mjs scripts/test-printers-merge.mjs scripts/test-printers-drivers.mjs scripts/test-printers-ps.mjs scripts/test-printers-service.mjs scripts/test-compute-version.mjs scripts/test-updater.mjs",
    "version:compute": "node scripts/compute-version.mjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "build": {
    "appId": "io.github.tonissx.toniinfrakit",
    "productName": "Toni Infrakit",
    "publish": {
      "provider": "github",
      "owner": "tonissx",
      "repo": "toni-infrakit",
      "releaseType": "release"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "!renderer/dist/*.map",
      "src/printers/**",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.toni-infrakit.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
